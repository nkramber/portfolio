---
// The frame of the placeholder pages (D-73): the head, the main landmark, the
// design tokens of PR-7, and the base styles. The home page (D-40) and the 404
// page (D-64) share it. The page shell of PR-8 replaces the layout, and the
// tokens move with it.
//
// The `?url` import gives the hashed address that Vite writes for the font, the
// same file that the @font-face rule below loads.
import textFontUrl from '../fonts/atkinson-hyperlegible-next-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  // A 404 page never shows in search results, so it needs no description.
  description?: string;
}

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <!-- Every page shows the text face, so the browser fetches it early (D-92).
         A font preload needs crossorigin, even from the same origin. -->
    <link rel="preload" href={textFontUrl} as="font" type="font/woff2" crossorigin />
    <!-- No favicon yet. The empty data URL stops the browser from requesting /favicon.ico. -->
    <link rel="icon" href="data:," />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* The fonts of D-91, self-hosted under the SIL Open Font License 1.1 (src/fonts/).
     `optional` never swaps: a late font leaves that page view in the fallback face,
     and nothing shifts (D-92). The unicode-range is the Latin subset of each file. */
  @font-face {
    font-family: 'Atkinson Hyperlegible Next';
    font-style: normal;
    font-weight: 200 800;
    font-display: optional;
    src: url('../fonts/atkinson-hyperlegible-next-latin-wght-normal.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  /* The mono face has no preload: the browser fetches it only when a tag, a badge,
     or a label uses it (D-27, D-92). */
  @font-face {
    font-family: 'Atkinson Hyperlegible Mono';
    font-style: normal;
    font-weight: 200 800;
    font-display: optional;
    src: url('../fonts/atkinson-hyperlegible-mono-latin-wght-normal.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  /* The design tokens (D-27, D-31). The light scheme is the default, and the dark
     scheme follows the system setting, with no toggle. Each ratio is the WCAG 2.2
     contrast against --color-bg of the same scheme. */
  :root {
    color-scheme: light dark;

    --font-text: 'Atkinson Hyperlegible Next', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --font-mono: 'Atkinson Hyperlegible Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;

    --color-bg: #fafaf8;
    --color-text: #151515; /* 17.47:1 */
    --color-muted: #5e5e59; /* 6.24:1 */
    --color-rule: #e3e2dd; /* a hairline between rows, decorative */
    --color-accent: #1f4fd1; /* 6.49:1, Blueprint cobalt (D-91) */
    --color-accent-tint: #e0e5f3; /* the accent on this tint: 5.38:1 */

    /* The type scale. Each fluid size stays at or under 2 times its smallest value,
       so browser zoom at 400 percent still doubles the text (WCAG 1.4.4). */
    --text-base: 1rem;
    --text-name: clamp(1rem, 0.9rem + 0.4vw, 1.125rem);
    --text-link: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
    --text-lead: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    --text-display: clamp(2.375rem, 0.9rem + 5.2vw, 4.75rem);

    --leading-display: 1.05;
    --leading-lead: 1.4;
    --leading-body: 1.5;

    --space-s: 0.75rem;
    --space-m: 1rem;
    --space-l: 1.5rem;
    --space-section: clamp(1.5rem, 6vw, 5rem);
    --gutter: 1.25rem;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-bg: #101010;
      --color-text: #ececE8; /* 16.07:1 */
      --color-muted: #a4a49f; /* 7.60:1 */
      --color-rule: #2b2b29;
      --color-accent: #86a8ff; /* 8.21:1 */
      --color-accent-tint: #232836; /* the accent on this tint: 6.34:1 */
    }
  }

  /* Base styles (T-2). */

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-text);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    /* A long word breaks inside its box, so it never pushes the page sideways (G-1). */
    overflow-wrap: break-word;
  }

  /* The underline stays at rest: the accent differs from the text by color alone
     below 3:1, and color alone fails WCAG 1.4.1 (F73). */
  a {
    color: var(--color-accent);
    text-decoration-line: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.2em;
    /* Tab scrolls a link into view with room for its focus ring (WCAG 2.4.11). */
    scroll-margin-block: 1rem;
  }

  a:hover {
    text-decoration-thickness: 0.16em;
  }

  /* The accent meets 3:1 against the page in both schemes (WCAG 1.4.11, 2.4.7). */
  :focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  ::selection {
    background: var(--color-accent-tint);
    color: var(--color-text);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* The placeholder layout. PR-8 replaces it. */

  main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-m);
    min-height: 100svh;
    max-width: 60rem;
    margin-inline: auto;
    padding-block: var(--space-section);
    padding-inline: var(--gutter);
    /* The headline rules below measure this box in its own text size (@container). */
    container-type: inline-size;
  }

  .name,
  .lede,
  .home,
  h1 {
    margin: 0;
  }

  .name {
    font-size: var(--text-name);
    font-weight: 600;
  }

  h1 {
    max-width: 20ch;
    font-size: var(--text-display);
    font-weight: 650;
    line-height: var(--leading-display);
    letter-spacing: -0.02em;
    /* Baseline Newly available: a browser without it wraps the line normally (G-6). */
    text-wrap: balance;
  }

  /* A word pair that must not split across a line end (src/pages/index.astro). */
  .keep {
    white-space: nowrap;
  }

  /* With enlarged text on a narrow screen, a long headline word gets a hyphen instead
     of a bare break, and a kept word pair may wrap. An em in a container query counts
     the font size of the container: at 320 CSS pixels, the main box is 17.5em wide at
     the default text size and 7.5em wide at 200 percent. */
  @container (max-width: 14em) {
    h1 {
      hyphens: auto;
    }

    .keep {
      white-space: normal;
    }
  }

  .lede {
    max-width: 34ch;
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-l);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-link);
  }

  /* The padding makes each link a pointer target well above 24 by 24 CSS pixels (WCAG 2.5.8). */
  .links a,
  .home a {
    display: inline-block;
    padding-block: var(--space-s);
    /* An inline-block keeps its longest word as its minimum width, so a long word
       must break anywhere to stay inside the page (G-1). */
    overflow-wrap: anywhere;
  }
</style>
