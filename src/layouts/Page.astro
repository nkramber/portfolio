---
// The frame of every page (D-73, PR-8): the head, the design tokens of PR-7, and
// the base styles. Each page writes its own landmarks inside the body, so each
// page file shows its whole structure.
//
// The `?url` import gives the hashed address that Vite writes for the font, the
// same file that the @font-face rule below loads.
import textFontUrl from '../fonts/atkinson-hyperlegible-next-latin-wght-normal.woff2?url';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <!-- Every page shows the text face, so the browser fetches it early (D-92).
         A font preload needs crossorigin, even from the same origin. -->
    <link rel="preload" href={textFontUrl} as="font" type="font/woff2" crossorigin />
    <!-- A page adds its description, its canonical address, its share tags, and a
         preload for each other face that it shows, here (D-111). The text face comes
         first, because the headline uses it. A 404 page never shows in search
         results, so it adds no tags. -->
    <slot name="head" />
    <!-- The icons of D-96. scripts/make-images.mjs draws both PNG files from
         public/favicon.svg. Google Search takes no SVG, so it reads the PNG. Of two
         icons that fit equally well, a browser takes the last one, the SVG. -->
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* The fonts of D-91, self-hosted under the SIL Open Font License 1.1 (src/fonts/).
     `optional` never swaps: a late font leaves that page view in the fallback face,
     and nothing shifts (D-92). The unicode-range is the Latin subset of each file. */
  @font-face {
    font-family: 'Atkinson Hyperlegible Next';
    font-style: normal;
    font-weight: 200 800;
    font-display: optional;
    src: url('../fonts/atkinson-hyperlegible-next-latin-wght-normal.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  /* The mono face of the tags, the badges, and the labels (D-27). The home page
     preloads it while it shows project cards, and the 404 page never fetches it
     (D-92, D-111). */
  @font-face {
    font-family: 'Atkinson Hyperlegible Mono';
    font-style: normal;
    font-weight: 200 800;
    font-display: optional;
    src: url('../fonts/atkinson-hyperlegible-mono-latin-wght-normal.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  /* The design tokens (D-27, D-31, D-169). The light scheme is the default, and the
     dark scheme follows the system setting, with no toggle. Each ratio is the WCAG 2.2
     contrast against --color-bg of the same scheme, and then against
     --color-surface, the ground of each card. */
  :root {
    color-scheme: light dark;

    --font-text: 'Atkinson Hyperlegible Next', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --font-mono: 'Atkinson Hyperlegible Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;

    --color-bg: #f4f5f8;
    --color-surface: #ffffff; /* the ground of each card */
    --color-text: #14161c; /* 16.59:1, 18.08:1 */
    --color-muted: #565c69; /* 6.15:1, 6.71:1 */
    --color-rule: #dfe2ea; /* the card border, decorative */
    --color-tag-rule: #878c98; /* 3.09:1, 3.37:1, the tag outline carries information (D-142) */
    --color-accent: #1f4fd1; /* 6.22:1, 6.78:1, Blueprint cobalt (D-91) */
    --color-accent-tint: #e3e9fa; /* the accent on this tint: 5.59:1 */

    /* The three stops of the headline gradient (D-169). Each stop alone meets 4.5:1
       against --color-bg, so every point of the headline meets it too:
       6.22:1, 6.36:1, and 5.76:1. */
    --gradient-1: #1f4fd1;
    --gradient-2: #6d2fd6;
    --gradient-3: #b4235f;

    /* Decoration alone: the glow behind the hero, the blueprint grid, and the card
       shadow. No text depends on them. Where both glows and a grid line meet at full
       strength, each headline stop still keeps 4.30:1 or more. */
    --glow-1: rgb(31 79 209 / 0.08);
    --glow-2: rgb(109 47 214 / 0.06);
    --grid-line: rgb(31 79 209 / 0.06);
    --shadow-card: 0 1px 2px rgb(20 22 28 / 0.04), 0 12px 32px -12px rgb(20 22 28 / 0.14);
    --shadow-card-hover: 0 2px 4px rgb(20 22 28 / 0.05), 0 24px 48px -16px rgb(31 79 209 / 0.28);

    /* The type scale. Each fluid size stays at or under 2 times its smallest value,
       so browser zoom at 400 percent still doubles the text (WCAG 1.4.4). */
    --text-base: 1rem;
    --text-label: 0.875rem; /* the mono tags, badges, and notes of the cards */
    --text-name: clamp(1rem, 0.9rem + 0.4vw, 1.125rem);
    --text-link: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
    --text-lead: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    --text-display: clamp(2.375rem, 0.9rem + 5.2vw, 4.75rem);

    --leading-display: 1.05;
    --leading-lead: 1.4;
    --leading-body: 1.5;

    --space-s: 0.75rem;
    --space-m: 1rem;
    --space-l: 1.5rem;
    --space-section: clamp(1.5rem, 6vw, 5rem);
    --gutter: 1.25rem;
    --radius-card: 1.5rem;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-bg: #0e1016;
      --color-surface: #161a24;
      --color-text: #eceef3; /* 16.38:1, 14.98:1 */
      --color-muted: #a5abb8; /* 8.26:1, 7.55:1 */
      --color-rule: #2a3142;
      --color-tag-rule: #6b7282; /* 3.94:1, 3.61:1 */
      --color-accent: #86a8ff; /* 8.20:1, 7.50:1 */
      --color-accent-tint: #232b40; /* the accent on this tint: 6.08:1 */

      /* 8.20:1, 9.06:1, and 9.51:1. Over the full glow and a grid line, 4.89:1 or
         more. */
      --gradient-1: #86a8ff;
      --gradient-2: #c3a3ff;
      --gradient-3: #f3a0b4;

      --glow-1: rgb(79 118 255 / 0.2);
      --glow-2: rgb(160 110 255 / 0.14);
      --grid-line: rgb(134 168 255 / 0.06);
      --shadow-card: 0 1px 2px rgb(0 0 0 / 0.3), 0 12px 32px -12px rgb(0 0 0 / 0.6);
      --shadow-card-hover: 0 2px 4px rgb(0 0 0 / 0.3), 0 24px 56px -16px rgb(79 118 255 / 0.35);
    }
  }

  /* Base styles (T-2). */

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-text);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    /* A long word breaks inside its box, so it never pushes the page sideways (G-1). */
    overflow-wrap: break-word;
  }

  /* The backdrop of the first screen (D-169): a blueprint grid and a soft glow in the
     accent colors, both fading out toward the bottom. It is decoration alone, so it
     sits behind every landmark and takes no pointer. The box covers the width of the
     window and no more, so it never scrolls the page sideways (G-1). */
  body::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: min(100svh, 56rem);
    background:
      radial-gradient(40rem 28rem at 78% 8%, var(--glow-2), transparent 70%),
      radial-gradient(48rem 32rem at 12% 0%, var(--glow-1), transparent 70%),
      linear-gradient(var(--grid-line) 1px, transparent 1px) 0 0 / 2.5rem 2.5rem,
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px) 0 0 / 2.5rem 2.5rem;
    mask-image: linear-gradient(to bottom, black 40%, transparent);
    pointer-events: none;
  }

  h1,
  h2,
  h3,
  p,
  ul {
    margin: 0;
  }

  /* The underline stays at rest: the accent differs from the text by color alone
     below 3:1, and color alone fails WCAG 1.4.1 (F73). */
  a {
    color: var(--color-accent);
    text-decoration-line: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.2em;
    /* Tab scrolls a link into view with room for its focus ring (WCAG 2.4.11). */
    scroll-margin-block: 1rem;
  }

  /* A touch screen keeps the hover state after a tap, so only a pointer that can
     hover gets the thicker underline. */
  @media (hover: hover) {
    a:hover {
      text-decoration-thickness: 0.16em;
    }
  }

  /* The accent meets 3:1 against the page in both schemes (WCAG 1.4.11, 2.4.7). */
  :focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  ::selection {
    background: var(--color-accent-tint);
    color: var(--color-text);
  }

  /* Text for screen readers alone, such as the project name in each card link
     (D-121). */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Motion (D-27, D-95). The page moves only when the system allows motion, so a
     visitor who asks for reduced motion gets none (WCAG 2.3.3, W3C technique C39). */
  @media (prefers-reduced-motion: no-preference) {
    /* The keyframes hold the start state alone, and the base rules hold the end
       state. The animation has no fill mode and no delay, so nothing hides the hero. */
    .hero {
      animation: rise 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    a {
      transition: text-decoration-thickness 150ms ease-out;
    }

    .links a {
      transition:
        color 150ms ease-out,
        border-color 150ms ease-out,
        translate 150ms ease-out;
    }
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .links a:hover {
      translate: 0 -2px;
    }
  }

  /* The hero rises a few pixels into place. Only `translate` changes, never the
     opacity, so the text shows from the first frame, and the paint metrics of
     Lighthouse never wait for it. */
  @keyframes rise {
    from {
      translate: 0 0.75rem;
    }
  }

  /* This reset also stops any motion that a later rule adds outside the query above.
     Each animation and transition ends at once, with no delay. */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-delay: 0s !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      transition-delay: 0s !important;
      scroll-behavior: auto !important;
    }
  }

  /* The page layout (PR-8). Each landmark sits in one centered column. */

  main {
    max-width: 68rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* The first frame of the rise sits 0.75rem low. On the 404 page, the hero fills
     the window, so that offset would add a scrollbar for the length of the rise.
     The main box grows with its content, so the clip hides nothing else. */
  main {
    overflow-y: clip;
  }

  /* The hero fills the visible height of a phone with its toolbar shown (svh), and
     centers its text. */
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-m);
    min-height: 100svh;
    padding-block: var(--space-section);
    /* The headline rules below measure this box in its own text size (@container). */
    container-type: inline-size;
  }

  /* The name reads as a label above the headline (D-27): the mono face, with a small
     accent mark before it. */
  .name {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-mono);
    font-size: var(--text-name);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .name::before {
    content: '';
    flex: none;
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--gradient-1), var(--gradient-3));
  }

  h1 {
    max-width: 20ch;
    font-size: var(--text-display);
    font-weight: 650;
    line-height: var(--leading-display);
    letter-spacing: -0.02em;
    /* Baseline Newly available: a browser without it wraps the line normally (G-6). */
    text-wrap: balance;
  }

  /* The headline fills with the gradient of D-169. Baseline does not list a clip of
     the background to the text (web-features 3.40.0), so it adds polish alone (G-6).
     A browser that cannot clip keeps the plain text color. Forced colors drop the
     gradient, so the text takes the system color there (WCAG 1.4.3). */
  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .hero h1 {
      background: linear-gradient(100deg, var(--gradient-1), var(--gradient-2) 55%, var(--gradient-3));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }

  @media (forced-colors: active) {
    .hero h1 {
      background: none;
      color: CanvasText;
    }
  }

  /* A word pair that must not split across a line end (src/pages/index.astro). */
  .keep {
    white-space: nowrap;
  }

  /* With enlarged text on a narrow screen, a long headline word can get a hyphen
     instead of a bare break, and a kept word pair may wrap. A word that the browser
     cannot hyphenate still breaks with no hyphen. An em in a container query counts
     the font size of the container: at 320 CSS pixels, the hero box is 17.5em wide at
     the default text size and 7.5em wide at 200 percent. */
  @container (max-width: 14em) {
    h1 {
      hyphens: auto;
    }

    .keep {
      white-space: normal;
    }
  }

  .lede {
    max-width: 34ch;
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
    /* The same polish as the headline: no lone word on the last line (G-6). */
    text-wrap: balance;
  }

  /* A section heading: About and Projects. A short gradient bar leads into it. */
  h2 {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    font-size: var(--text-lead);
    font-weight: 650;
    line-height: var(--leading-lead);
    /* The heading text is a flex item, which keeps its longest word as its minimum
       width. With the bar beside it, a word must break anywhere to stay inside the
       page at 320 px with large text (G-1). */
    overflow-wrap: anywhere;
  }

  h2::before {
    content: '';
    flex: none;
    width: 1.5rem;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--gradient-1), var(--gradient-3));
  }

  /* The About section of the home page (OQ-3). */
  .about {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding-block: var(--space-section);
  }

  .about p {
    max-width: 65ch;
  }

  /* The Projects section of the home page (D-21). The page ends here, so the section
     keeps at least 4rem below its last card. With less, the end reads as the start of
     another card (D-137). */
  .projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    padding-block: var(--space-section);
    padding-block-end: max(4rem, var(--space-section));
  }

  /* With project cards below it, the hero stops 10rem short of the screen height, so
     the Projects heading shows at the bottom of the first screen (D-117). The 404
     page has no cards, so its hero keeps the full height. */
  .hero:has(~ .projects) {
    min-height: calc(100svh - 10rem);
  }

  /* The project cards sit in a grid (D-169): two columns on a wide screen, and one
     column on a phone. A column never gets narrower than 22rem or the full width, so
     a third card starts a new row. Each card in a row takes the height of the tallest. */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-l);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-s);
    padding: 0;
    list-style: none;
    font-size: var(--text-link);
  }

  /* Each profile link is a pill with its icon and its name (D-144, D-169). The name
     stays visible, and the icon is hidden from assistive technology. The padding
     makes each link a pointer target well above 24 by 24 CSS pixels (WCAG 2.5.8). */
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.5em 0.9em;
    border: 1px solid var(--color-tag-rule);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .links svg {
    flex: none;
    width: 1.1em;
    height: 1.1em;
  }

  /* The pill border already marks each profile link as a control, so it needs no
     underline (WCAG 1.4.1). A pointer that can hover gets the accent. */
  @media (hover: hover) {
    .links a:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
  }

  /* The padding makes each link a pointer target well above 24 by 24 CSS pixels (WCAG 2.5.8). */
  .home a {
    display: inline-block;
    padding-block: var(--space-s);
    /* An inline-block keeps its longest word as its minimum width, so a long word
       must break anywhere to stay inside the page (G-1). */
    overflow-wrap: anywhere;
  }
</style>
