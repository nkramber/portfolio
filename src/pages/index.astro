---
// The home page (D-19, D-21): the hero with the profile links, the About section,
// and the project cards. The Links section at the end of the page comes back with
// the cards (D-102).
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import ProjectCard from '../components/ProjectCard.astro';

// The two profile links of D-20. The hero shows them (D-102).
const links = [
  { label: 'GitHub', href: 'https://github.com/nkramber' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/nate-kramber' },
];

// The bio of OQ-3, one string for each paragraph. The session drafts it from an
// interview with the owner, and the owner approves the words (D-94). The About
// section stays off the page while this list is empty.
const about: string[] = [];

// The project cards, lowest order number first (D-23). The collection returns its
// entries in no fixed order, so the page sorts them. The Projects section stays off
// the page while the collection has no entry.
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const orders = projects.map((project) => project.data.order);
if (new Set(orders).size !== orders.length) {
  throw new Error('Two project entries share one order number (D-23).');
}

// The headline and the second line of D-29, word for word (D-99).
const description =
  'I design the systems. AI agents write the code. I decide what ships. Tools and games, built under strict rules and real review.';

// Each absolute address comes from `site` in astro.config.mjs (D-41).
const homeUrl = new URL('/', Astro.site).href;
const shareImageUrl = new URL('/og.png', Astro.site).href;
---

<Page title="Nate Kramber">
  <Fragment slot="head">
    <meta name="description" content={description} />
    <link rel="canonical" href={homeUrl} />
    <!-- The share card of D-97 (https://ogp.me). scripts/make-images.mjs draws the image. -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={homeUrl} />
    <meta property="og:title" content="Nate Kramber" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nate Kramber. I design the systems. AI agents write the code. I decide what ships." />
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>

  <main>
    <div class="hero">
      <p class="name">Nate Kramber</p>
      <!-- Each "keep" span holds a word pair on one line, so no line ends with a lone "I" or "AI". -->
      <h1>I design the systems. <span class="keep">AI agents</span> write the code. <span class="keep">I decide</span> what ships.</h1>
      <p class="lede">Tools and games, built under strict rules and real review.</p>
      <ul class="links">
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </div>

    {about.length > 0 && (
      <section class="about" aria-labelledby="about-heading">
        <h2 id="about-heading">About</h2>
        {about.map((paragraph) => <p>{paragraph}</p>)}
      </section>
    )}

    {projects.length > 0 && (
      <section class="projects" aria-labelledby="projects-heading">
        <h2 id="projects-heading">Projects</h2>
        {projects.map((project) => <ProjectCard project={project} />)}
      </section>
    )}
  </main>
</Page>
