---
// The home page (D-19, D-21): the hero with the profile links, the About section,
// and the project cards. The page ends after the projects, because the Links
// section left the site with D-136.
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import ProjectCard from '../components/ProjectCard.astro';
// The hashed address of the mono face, the same file that the @font-face rule of the
// layout loads (src/layouts/Page.astro).
import monoFontUrl from '../fonts/atkinson-hyperlegible-mono-latin-wght-normal.woff2?url';

// The two profile links of D-20. The hero alone shows them (D-136). Each one leaves
// the site, so it opens a new tab (D-166).
// Each icon is the inner SVG markup of one Lucide icon, 24 by 24 with a 2 px stroke
// (lucide-static 1.0.0, ISC license, Copyright (c) Lucide Contributors). The label
// beside it names the link, so the icon is hidden from assistive technology (D-169).
const links = [
  {
    label: 'GitHub',
    href: 'https://github.com/nkramber',
    icon: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/nate-kramber',
    icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  },
];

// The bio of OQ-3, one string for each paragraph. The session drafts it from an
// interview with the owner, and the owner approves the words (D-94). The About
// section stays off the page while this list is empty.
const about: string[] = [];

// The project cards, lowest order number first (D-23). The collection returns its
// entries in no fixed order, so the page sorts them. The Projects section stays off
// the page while the collection has no entry.
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const orders = projects.map((project) => project.data.order);
if (new Set(orders).size !== orders.length) {
  throw new Error('Two project entries share one order number (D-23).');
}

// The headline and the second line of D-29, word for word (D-99).
const description =
  'I design the systems. AI agents write the code. I decide what ships. Tools and games, built under strict rules and real review.';

// Each absolute address comes from `site` in astro.config.mjs (D-41).
const homeUrl = new URL('/', Astro.site).href;
const shareImageUrl = new URL('/og.png', Astro.site).href;
---

<Page title="Nate Kramber">
  <Fragment slot="head">
    <meta name="description" content={description} />
    <link rel="canonical" href={homeUrl} />
    <!-- The share card of D-97 (https://ogp.me). scripts/make-images.mjs draws the image. -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={homeUrl} />
    <meta property="og:title" content="Nate Kramber" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nate Kramber. I design the systems. AI agents write the code. I decide what ships." />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- The tags and the status badges of the cards use the mono face. Without a
         preload, the browser finds the face too late for `font-display: optional`,
         and a first visit shows the fallback face (D-111). -->
    {projects.length > 0 && <link rel="preload" href={monoFontUrl} as="font" type="font/woff2" crossorigin />}
  </Fragment>

  <main>
    <div class="hero">
      <p class="name">Nate Kramber</p>
      <!-- Each "keep" span holds a word pair on one line, so no line ends with a lone "I" or "AI". -->
      <h1>I design the systems. <span class="keep">AI agents</span> write the code. <span class="keep">I decide</span> what ships.</h1>
      <p class="lede">Tools and games, built under strict rules and real review.</p>
      <ul class="links" role="list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={link.icon}
                />
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {about.length > 0 && (
      <section class="about" aria-labelledby="about-heading">
        <h2 id="about-heading">About</h2>
        {about.map((paragraph) => <p>{paragraph}</p>)}
      </section>
    )}

    {projects.length > 0 && (
      <section class="projects" aria-labelledby="projects-heading">
        <h2 id="projects-heading">Projects</h2>
        <div class="card-grid">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    )}
  </main>
</Page>
