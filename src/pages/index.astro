---
// The placeholder page (D-40, D-41). It shows the headline (D-29) and the
// profile links (D-20) until the page shell of PR-8 replaces it.
const links = [
  { label: 'GitHub', href: 'https://github.com/nkramber' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/nate-kramber' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Nate Kramber</title>
    <meta
      name="description"
      content="Nate Kramber designs the systems, directs the AI agents that write the code, and decides what ships."
    />
    <!-- No favicon yet. The empty data URL stops the browser from requesting /favicon.ico. -->
    <link rel="icon" href="data:," />
  </head>
  <body>
    <main>
      <p class="name">Nate Kramber</p>
      <h1>I design the systems. AI agents write the code. I decide what ships.</h1>
      <p class="lede">Tools and games, built under strict rules and real review.</p>
      <ul class="links">
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </main>
  </body>
</html>

<style is:global>
  /* Light and dark follow the system setting (D-27). The design tokens of PR-7 replace these values.
     Each pair meets WCAG contrast in its scheme: the text is above 15 to 1, and the links are above 8 to 1. */
  :root {
    color-scheme: light dark;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
    background: #ffffff;
    color: #111111;
  }

  a {
    color: #0645ad;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      background: #121212;
      color: #eeeeee;
    }

    a {
      color: #8ab4f8;
    }
  }

  body {
    margin: 0;
  }

  main {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    min-height: 100svh;
    max-width: 60rem;
    margin-inline: auto;
    padding-block: clamp(1.5rem, 6vw, 5rem);
    padding-inline: 1.25rem;
  }

  .name,
  .lede,
  h1 {
    margin: 0;
  }

  .name {
    font-weight: 600;
  }

  h1 {
    font-size: clamp(2rem, 1rem + 5vw, 4.5rem);
    line-height: 1.1;
    /* Baseline Newly available: a browser without it wraps the line normally (G-6). */
    text-wrap: balance;
  }

  .lede {
    max-width: 40ch;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The padding makes each link a pointer target well above 24 by 24 CSS pixels (WCAG 2.5.8). */
  .links a {
    display: inline-block;
    padding-block: 0.75rem;
  }
</style>
