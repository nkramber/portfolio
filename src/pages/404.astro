---
// The 404 page (D-64). Astro builds it to dist/404.html, and the server sends it
// for every missing address. It keeps the words of D-74 (D-98).
import Page from '../layouts/Page.astro';
---

<Page title="Page not found | Nate Kramber">
  <main>
    <div class="hero">
      <h1>There’s no page at this address.</h1>
      <p class="home"><a href="/">Go to the home page</a></p>
    </div>
  </main>
</Page>
