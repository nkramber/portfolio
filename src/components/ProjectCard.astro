---
// One project card (D-2, G-2). Every project uses this component, and its facts
// come from one entry of the `projects` collection (src/content.config.ts).
//
// A card shows every fact at once: no disclosure, and no highlights (D-133). An
// optional logo sits beside the title, and an optional screenshot follows the links.
// A card with neither shows no image (D-134).
// The heading names the project, so the logo is decoration and takes an empty alt
// (WCAG 1.1.1). The Image component gets no width and no format, so an SVG passes
// through untouched and a raster file keeps its own size. Picture cannot process an
// SVG, so the schema keeps a screenshot raster.
// Every screenshot draws in the same 16 by 10 frame: a taller image shows its top,
// and a wider image loses a part of its sides (D-138).
// A `ul` takes no text child, so the tag list gives its own name with `aria-label`.
// A link note, such as "Invite only", also describes its link, so a screen reader
// user who tabs from link to link still hears it.
// Each link also holds the project name as hidden text, for example "Source on
// GitHub (Deck Tome)", so two cards can share a visible label (D-121). The hidden
// text starts with a space: the span counts as a block, so a leading comma would
// get a stray space before it (D-122).
import type { CollectionEntry } from 'astro:content';
import { Image, Picture } from 'astro:assets';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, pitch, status, tags, links, logo, screenshot } = project.data;
const headingId = `project-${project.id}`;
---

<article class="card" aria-labelledby={headingId}>
  <div class="head">
    {logo && <Image class="logo" src={logo} alt="" />}
    <h3 id={headingId}>{title}</h3>
    <p class="status"><span class="visually-hidden">Status: </span>{status}</p>
  </div>
  <p class="pitch">{pitch}</p>
  <ul class="tags" aria-label="Tags">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
  <ul class="card-links">
    {
      links.map((link, index) => {
        const noteId = `${headingId}-note-${index}`;
        return (
          <li>
            <a href={link.href} aria-describedby={link.note ? noteId : undefined}>
              {link.label}<span class="visually-hidden"> ({title})</span>
            </a>
            {link.note && (
              <span class="note" id={noteId}>
                {link.note}
              </span>
            )}
          </li>
        );
      })
    }
  </ul>
  {
    screenshot && (
      <Picture
        class="shot"
        src={screenshot.src}
        alt={screenshot.alt}
        formats={['avif', 'webp']}
        widths={[480, 960, 1440]}
        sizes="(min-width: 60rem) 57.5rem, calc(100vw - 2.5rem)"
      />
    )
  }
</article>

<style>
  /* One project row (D-27): a hairline above the card, then its facts in one column. */
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding-block: var(--space-l);
    border-block-start: 1px solid var(--color-rule);
  }

  /* The logo, the title, and the status badge share one row, and each part wraps
     under the row when it gets too narrow (D-109, D-133). */
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-s) var(--space-m);
  }

  /* The logo keeps the ratio of its own file inside a 10rem by 2rem box: a square
     mark meets the height cap, and a wide wordmark meets the width cap with no
     letterbox. The row aligns its text on the baseline, and a mark has no baseline,
     so the logo centers on the row instead of hanging above it. A logo file carries
     its own ground, because forced colors leave an image alone (OQ-8). */
  .logo {
    align-self: center;
    block-size: auto;
    inline-size: auto;
    max-block-size: 2rem;
    max-inline-size: 10rem;
  }

  h3 {
    font-size: var(--text-lead);
    font-weight: 650;
    line-height: var(--leading-lead);
    /* A flex item keeps its longest word as its minimum width, so a long name must
       break anywhere to stay inside the page (G-1). */
    overflow-wrap: anywhere;
  }

  /* The labels of D-27 use the mono face. */
  .status,
  .tags,
  .note {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    overflow-wrap: anywhere;
  }

  /* The accent on its tint meets 5.38:1 in light and 6.34:1 in dark (WCAG 1.4.3).
     Forced colors drop the tint, and the transparent outline then takes the text
     color, so the pill keeps its shape. */
  .status {
    padding: 0.125rem 0.625rem;
    border-radius: 1rem;
    background: var(--color-accent-tint);
    color: var(--color-accent);
    outline: 1px solid transparent;
  }

  .pitch {
    max-width: 65ch;
  }

  .tags,
  .card-links {
    display: flex;
    flex-wrap: wrap;
    padding: 0;
    list-style: none;
  }

  .tags {
    gap: var(--space-s);
    color: var(--color-muted);
  }

  /* Each tag sits in a hairline outline, so a tag that wraps still reads as one tag
     (D-108). The outline is decoration, so no contrast rule applies to it. */
  .tags li {
    padding-inline: 0.4em;
    border: 1px solid var(--color-rule);
    border-radius: 0.25rem;
  }

  /* The gap between two links is wider than the gap between a link and its note, so
     a note that moves under its link stays with that link (D-119). */
  .card-links {
    gap: var(--space-l);
    font-size: var(--text-link);
  }

  /* A note stays beside its link, or moves under it as one unit, so it never splits
     across two lines or hangs between two links. The row gap keeps the 6 px focus
     ring of the link off a note below it. */
  .card-links li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5em;
  }

  /* The padding makes each link a pointer target well above 24 by 24 CSS pixels (WCAG 2.5.8). */
  .card-links a {
    display: inline-block;
    padding-block: var(--space-s);
    overflow-wrap: anywhere;
  }

  /* A link with a note has no bottom padding, so a note under it sits close to it
     (D-119). The top padding and the line height keep the target above 24 CSS pixels. */
  .card-links a:has(+ .note) {
    padding-block-end: 0;
  }

  .note {
    color: var(--color-muted);
  }

  /* A block image leaves no gap below it for the text baseline. The hairline frames
     a screenshot with a light background in the light scheme. The image loads lazily,
     so a screenshot below the first screen costs nothing on the first load.
     Every card draws its screenshot in the same 16 by 10 frame, and a taller image
     shows its top (D-138). The frame gives the box its height before the image
     arrives, so nothing moves on load. */
  .shot {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    margin-block-start: var(--space-s);
    border: 1px solid var(--color-rule);
  }
</style>
