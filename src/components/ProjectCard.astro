---
// One project card (D-2, G-2). Every project uses this component, and its facts
// come from one entry of the `projects` collection (src/content.config.ts).
//
// A card shows every fact at once: no disclosure, and no highlights (D-133). An
// optional logo sits beside the title, and an optional screenshot follows the links.
// A card with neither shows no image (D-134).
// The heading names the project, so the logo is decoration and takes an empty alt
// (WCAG 1.1.1). The Image component gets no width and no format, so an SVG passes
// through untouched and a raster file keeps its own size. Picture cannot process an
// SVG, so the schema keeps a screenshot raster.
// Every screenshot draws in the same 16 by 10 frame: a taller image shows its top,
// and a wider image loses a part of its sides (D-138).
// A `ul` takes no text child, so the tag list gives its own name with `aria-label`.
// A link note, such as "Invite only", also describes its link, so a screen reader
// user who tabs from link to link still hears it.
// Each link also holds the project name as hidden text, for example "Source on
// GitHub (Deck Tome)", so two cards can share a visible label (D-121). The hidden
// text starts with a space: the span counts as a block, so a leading comma would
// get a stray space before it (D-122).
// The schema keeps each link address absolute, so every card link leaves the site and
// opens a new tab. The link gives no notice of the new tab, because WCAG 2.2 puts that
// notice at level AAA and the site holds level AA (D-165, D-166, T-2).
import type { CollectionEntry } from 'astro:content';
import { Image, Picture } from 'astro:assets';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, pitch, status, tags, links, logo, screenshot } = project.data;
const headingId = `project-${project.id}`;
---

<article class="card" aria-labelledby={headingId}>
  <div class="face">
    <div class="head">
      {logo && <Image class="logo" src={logo} alt="" />}
      <h3 id={headingId}>{title}</h3>
      <p class="status"><span class="visually-hidden">Status: </span>{status}</p>
    </div>
    <p class="pitch">{pitch}</p>
    <ul class="tags" role="list" aria-label="Tags">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <ul class="card-links" role="list">
      {
        links.map((link, index) => {
          const noteId = `${headingId}-note-${index}`;
          return (
            <li>
              <a href={link.href} target="_blank" rel="noopener" aria-describedby={link.note ? noteId : undefined}>
                {link.label}<span class="visually-hidden"> ({title})</span>
              </a>
              {link.note && (
                <span class="note" id={noteId}>
                  {link.note}
                </span>
              )}
            </li>
          );
        })
      }
    </ul>
    {
      screenshot && (
        <Picture
          class="shot"
          src={screenshot.src}
          alt={screenshot.alt}
          formats={['avif', 'webp']}
          widths={[480, 960, 1440]}
          sizes="(min-width: 48rem) 29rem, calc(100vw - 5rem)"
        />
      )
    }
  </div>
</article>

<style>
  /* One raised project card in the grid of the home page (D-169): its facts in one
     column on the card surface, with rounded corners and a soft shadow.
     The card itself is a still box that takes the hover, and its face carries the
     look. So when the face rises, the pointer stays inside the card, and the hover
     never flickers at the bottom edge. The card fills its grid cell, and the face
     fills the card, so two cards in one row share one height. */
  .card {
    display: grid;
  }

  /* The face draws its border in three layers. The face ground shows the border
     color, the ::after layer lays the surface over it 2 px in from each edge, and
     the ::before layer holds a conic gradient between the two. The gradient shows
     only while a pointer rests on the card or a card link shows the keyboard focus,
     and then it turns, so a colored light runs around the border (D-170). Both
     layers keep the exact box of the face, so neither one adds scroll (G-1). */
  .face {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-l) clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-card);
    background: var(--color-rule);
    box-shadow: var(--shadow-card);
  }

  /* The light turns with the start angle of the gradient, not with the box, so the
     layer never leaves the face. */
  .face::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    border-radius: inherit;
    background: conic-gradient(
      from var(--turn),
      transparent 0 25%,
      var(--gradient-1),
      var(--gradient-2),
      var(--gradient-3),
      var(--gradient-1)
    );
    opacity: 0;
  }

  .face::after {
    content: '';
    position: absolute;
    inset: 2px;
    z-index: -1;
    border-radius: calc(var(--radius-card) - 2px);
    background: var(--color-surface);
  }

  .card:has(:focus-visible) .face {
    box-shadow: var(--shadow-card-hover);
  }

  .card:has(:focus-visible) .face::before {
    opacity: 1;
  }

  @media (hover: hover) {
    .card:hover .face {
      box-shadow: var(--shadow-card-hover);
    }

    .card:hover .face::before {
      opacity: 1;
    }
  }

  /* The motion of D-170 runs only when the system allows motion (WCAG 2.3.3). The
     light turns only while a visitor points at the card or focuses a link in it, so
     it never starts on its own (WCAG 2.2.2). Under reduced motion, the gradient shows
     and holds still. */
  @media (prefers-reduced-motion: no-preference) {
    .face {
      transition:
        translate 250ms cubic-bezier(0.2, 0.8, 0.2, 1),
        box-shadow 250ms ease-out;
    }

    .face::before {
      transition: opacity 250ms ease-out;
    }

    .card:has(:focus-visible) .face::before {
      animation: turn 4s linear infinite;
    }

    @media (hover: hover) {
      .card:hover .face {
        translate: 0 -4px;
      }

      .card:hover .face::before {
        animation: turn 4s linear infinite;
      }
    }
  }

  /* A registered angle can animate, so the gradient turns smoothly. @property is
     Baseline Newly available, so it adds polish alone (G-6): a browser without it
     keeps the gradient still at its start angle. */
  @property --turn {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes turn {
    to {
      --turn: 1turn;
    }
  }

  /* Forced colors drop each background, so the face draws a plain border there. */
  @media (forced-colors: active) {
    .face {
      border: 1px solid CanvasText;
    }
  }

  /* The logo, the title, and the status badge share one row, and each part wraps
     under the row when it gets too narrow (D-109, D-133). */
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-s) var(--space-m);
  }

  /* The logo keeps the ratio of its own file inside a 10rem by 2rem box: a square
     mark meets the height cap, and a wide wordmark meets the width cap with no
     letterbox. The row aligns its text on the baseline, and a mark has no baseline,
     so the logo centers on the row instead of hanging above it. A logo file carries
     its own ground, because forced colors leave an image alone (OQ-8). */
  .logo {
    align-self: center;
    block-size: auto;
    inline-size: auto;
    max-block-size: 2rem;
    max-inline-size: 10rem;
  }

  h3 {
    font-size: var(--text-lead);
    font-weight: 650;
    line-height: var(--leading-lead);
    /* A flex item keeps its longest word as its minimum width, so a long name must
       break anywhere to stay inside the page (G-1). */
    overflow-wrap: anywhere;
  }

  /* The labels of D-27 use the mono face. */
  .status,
  .tags,
  .note {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    overflow-wrap: anywhere;
  }

  /* The accent on its tint meets 5.38:1 in light and 6.34:1 in dark (WCAG 1.4.3).
     Forced colors drop the tint, and the transparent outline then takes the text
     color, so the pill keeps its shape. */
  .status {
    padding: 0.125rem 0.625rem;
    border-radius: 1rem;
    background: var(--color-accent-tint);
    color: var(--color-accent);
    outline: 1px solid transparent;
  }

  .pitch {
    max-width: 65ch;
  }

  .tags,
  .card-links {
    display: flex;
    flex-wrap: wrap;
    padding: 0;
    list-style: none;
  }

  /* The links sit at the foot of the card, so two cards in one row line up. */
  .card-links {
    margin-block-start: auto;
  }

  .tags {
    gap: var(--space-s);
    color: var(--color-muted);
  }

  /* Each tag sits in an outline, so a tag that wraps still reads as one tag
     (D-108). That outline carries information, so it holds 3:1 against the page
     (WCAG 1.4.11, D-142). The card hairline stays decoration at --color-rule. */
  .tags li {
    padding: 0.1em 0.6em;
    border: 1px solid var(--color-tag-rule);
    border-radius: 999px;
    background: var(--color-bg);
  }

  /* The gap between two links is wider than the gap between a link and its note, so
     a note that moves under its link stays with that link (D-119). */
  .card-links {
    gap: var(--space-l);
    font-size: var(--text-link);
  }

  /* A note stays beside its link, or moves under it as one unit, so it never splits
     across two lines or hangs between two links. The row gap keeps the 6 px focus
     ring of the link off a note below it. */
  .card-links li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5em;
  }

  /* The padding makes each link a pointer target well above 24 by 24 CSS pixels (WCAG 2.5.8). */
  .card-links a {
    display: inline-block;
    padding-block: var(--space-s);
    overflow-wrap: anywhere;
  }

  /* A link with a note has no bottom padding, so a note under it sits close to it
     (D-119). The top padding and the line height keep the target above 24 CSS pixels. */
  .card-links a:has(+ .note) {
    padding-block-end: 0;
  }

  .note {
    color: var(--color-muted);
  }

  /* A block image leaves no gap below it for the text baseline. The hairline frames
     a screenshot with a light background in the light scheme. The image loads lazily,
     so a screenshot below the first screen costs nothing on the first load.
     Every card draws its screenshot in the same 16 by 10 frame, and a taller image
     shows its top (D-138). The frame gives the box its height before the image
     arrives, so nothing moves on load. */
  .shot {
    display: block;
    width: 100%;
    /* The height attribute of the image would win over the frame, so the height
       follows the width. */
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    margin-block-start: var(--space-s);
    border: 1px solid var(--color-rule);
    border-radius: calc(var(--radius-card) / 2);
  }
</style>
